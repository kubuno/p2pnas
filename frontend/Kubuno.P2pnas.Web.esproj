<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <!-- npm/Vite through the Kubuno tooling (docs/WEB.md, "Frontends"): Windows native packages when node_modules
       was installed by Linux, Node.js from Visual Studio when none is on PATH, no npm install over a foreign tree. -->
  <Sdk Name="Kubuno.Web.Sdk" Version="1.0.1" />

  <!-- Generated by "Kubuno Web: Generate Solution" (docs/WEB.md). This file is yours: never overwritten by a later run. -->
  <PropertyGroup>
    <KubunoWebRole>ModuleFrontend</KubunoWebRole>
    <KubunoModuleId>p2pnas</KubunoModuleId>
    <!-- F5: a watching vite build straight into the dev core's copy of this module, and Edge on the module with the script debugger. -->
    <LaunchJsonFolder>.kubuno</LaunchJsonFolder>
  </PropertyGroup>

</Project>
