# ─── Kubuno p2pnas — Configuration ──────────────────────────────────────────────
# Copiez ce fichier en config.toml et adaptez les valeurs.
# Les variables d'environnement préfixées KP__ surchargent ce fichier.
# Exemple : KP__SERVER__PORT=3119

[server]
host = "127.0.0.1"
port = 3119

[core]
# URL du core Kubuno (pour l'enregistrement du module)
url             = "http://127.0.0.1:8080"
# Secret partagé — doit correspondre à server.internal_secret dans le core
internal_secret = "change_me"

# ── Base de données ───────────────────────────────────────────────────────────
# Paramètres de connexion injectés par le superviseur Kubuno via
# KUBUNO_DB_HOST / KUBUNO_DB_PORT / KUBUNO_DB_USER / KUBUNO_DB_PASSWORD / KUBUNO_DB_NAME.
# Pour un démarrage hors superviseur, exporter ces variables manuellement.

# ── Stockage ──────────────────────────────────────────────────────────────────
[storage]
# Répertoire de données du nœud : clé d'identité, manifest SQLCipher, shards.
data_dir = "/var/lib/kubuno/modules/p2pnas"

# ── Réseau P2P ────────────────────────────────────────────────────────────────
[p2p]
# Écoute du listener pair-à-pair (port distinct de l'API HTTP). Ouvrir ce port
# côté pare-feu/box pour rejoindre le réseau de résilience.
host = "0.0.0.0"
port = 7474

[logging]
level  = "info"
format = "pretty"
