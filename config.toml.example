# ─── Kubuno p2pnas — Configuration ──────────────────────────────────────────────
# Copiez ce fichier en config.toml et adaptez les valeurs.
# Les variables d'environnement préfixées KP__ surchargent ce fichier.
# Exemple : KP__SERVER__PORT=3123

[server]
host = "127.0.0.1"
port = 3123

[core]
# URL du core Kubuno (pour l'enregistrement du module)
url             = "http://127.0.0.1:8080"
# Secret partagé — doit correspondre à server.internal_secret dans le core
internal_secret = "change_me"

# ── Base de données ───────────────────────────────────────────────────────────
# Paramètres de connexion injectés par le superviseur Kubuno via
# KUBUNO_DB_HOST / KUBUNO_DB_PORT / KUBUNO_DB_USER / KUBUNO_DB_PASSWORD / KUBUNO_DB_NAME.
# Pour un démarrage hors superviseur, exporter ces variables manuellement.

# ── Stockage ──────────────────────────────────────────────────────────────────
[storage]
# Répertoire de données du nœud : clé d'identité, manifest SQLCipher, shards.
data_dir = "/var/lib/kubuno/modules/p2pnas"

# ── Réseau P2P ────────────────────────────────────────────────────────────────
[p2p]
# Écoute du listener pair-à-pair (port distinct de l'API HTTP). Ouvrir ce port
# côté pare-feu/box pour rejoindre le réseau de résilience.
host = "0.0.0.0"
port = 7474

# ── Découverte de pairs ───────────────────────────────────────────────────────
[discovery]
# mDNS : découverte automatique des nœuds p2pnas sur le réseau local (zéro-config).
mdns = true
# DHT Kademlia : découverte à grande échelle (Internet). Nécessite des nœuds
# d'amorçage (bootstrap) pour rejoindre l'overlay. Ouvrir dht_port en UDP.
dht = false
dht_port = 7475
# dht_bootstrap = ["203.0.113.5:7475", "198.51.100.9:7475"]
# GeoIP hors-ligne (optionnel) : fournir un fichier GeoLite2-Country .mmdb pour
# activer les fonctions géo. geoip_allow = contrainte juridictionnelle : si non
# vide, les shards ne sont placés que sur des pairs des pays listés (ISO).
# geoip_db = "/var/lib/kubuno/modules/p2pnas/GeoLite2-Country.mmdb"
# geoip_allow = ["FR", "BE", "CH"]

[logging]
level  = "info"
format = "pretty"
