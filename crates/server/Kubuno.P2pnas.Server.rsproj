<Project Sdk="Kubuno.Rust.Sdk/1.1.1">
  <!-- The Kubuno web tooling (docs/WEB.md): F5 starts a dev core with this module deployed into it, behind the development database guard. -->
  <Sdk Name="Kubuno.Web.Sdk" Version="1.0.1" />

  <!-- Generated by "Kubuno Web: Generate Solution" (docs/WEB.md). This file is yours: it is never overwritten
       by a later run - edit it freely, or delete it and run the command again for a fresh default. -->
  <PropertyGroup>
    <CargoPackage>kubuno-p2pnas</CargoPackage>
    <!-- One `cargo build` of the workspace for every project of it (docs/RSPROJ.md, "Cargo workspaces"). -->
    <CargoBuildScope>Workspace</CargoBuildScope>
    <KubunoWebRole>Module</KubunoWebRole>
    <KubunoModuleDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</KubunoModuleDirectory>
  </PropertyGroup>

</Project>
